# Copy this file to .env (project root) and fill in the values.
# NEVER commit .env to git.

# Paid provider API keys (leave blank until you add them in the Render dashboard)
FAL_KEY=
GEMINI_API_KEY=
OPENROUTER_KEY=

# Optional: Pollinations API key (image generation works without one; video needs one)
POLLINATIONS_KEY=

# Admin token used in the x-admin-token header for recharge approvals.
# CHANGE THIS to a long random string before going live.
ADMIN_TOKEN=change-me-to-a-long-random-string

# Public base URL of the site (used to build image URLs sent to paid providers).
# Set to your Render URL after deploy, e.g. https://stunt-world-studio-ai.onrender.com
PUBLIC_BASE_URL=http://localhost:3000

PORT=3000
